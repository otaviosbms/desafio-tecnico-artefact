# Django
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Eventos estruturados do agente no console (INFO = todos; WARNING = só degradações e falhas)
# LOG_LEVEL=INFO

# Banco: Postgres local ou via `docker compose up -d db`.
# Sem DATABASE_URL o projeto usa SQLite (db.sqlite3).
DATABASE_URL=postgres://emporio:emporio@localhost:5432/emporio

# LLM: qualquer provedor compatível com o SDK da OpenAI (ver docs/05-camada-llm.md).
# Presets: openai, anthropic, gemini, groq, openrouter, deepseek, ollama, lmstudio, custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Chave do provedor escolhido (OPENAI_API_KEY, GROQ_API_KEY, ...) ou LLM_API_KEY.
OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=          # obrigatório para LLM_PROVIDER=custom
# LLM_TEMPERATURE=0.2
# Modelos de raciocínio: none, low, medium, high. Alguns só aceitam ferramentas com none.
# LLM_REASONING_EFFORT=
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# Modelo por papel (mesmo provedor e chave). Vazio = LLM_MODEL. Roteador e guardrails só
# classificam, então um modelo menor e mais rápido costuma bastar.
# LLM_MODEL_AGENT=
# LLM_MODEL_ROUTER=
# LLM_MODEL_GUARDRAILS=
# Saída estruturada: auto (testa json_schema -> json_object -> prompt) ou um nível fixo
# LLM_STRUCTURED_OUTPUT=auto

# Roteador de intenção: off | shadow (classifica e registra, sem restringir) | enforce (restringe
# as ferramentas do agente). Use enforce depois de conferir o `manage.py eval_router`.
# ROUTER_MODE=shadow
# ROUTER_MIN_CONFIDENCE=0.5

# Guardrails: off | shadow (avalia e registra, sem bloquear) | enforce (bloqueia e orienta o agente).
# Use enforce depois de conferir o `manage.py eval_guardrails` (meta: zero falsos bloqueios).
# GUARDRAILS_MODE=shadow
# GUARDRAILS_MAX_CONSECUTIVE_BLOCKS=3
