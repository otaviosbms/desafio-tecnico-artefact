# Copie para .env. As linhas comentadas mostram o valor padrão: só descomente para mudar.

# ---------- Django ----------
DJANGO_SECRET_KEY=troque-esta-chave
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Eventos estruturados no console: INFO = todos; WARNING = só degradações e falhas
# LOG_LEVEL=INFO

# ---------- Banco ----------
# O compose usa o serviço "db". Fora do Docker, sem DATABASE_URL, o projeto usa SQLite.
# Docker: senha do banco e portas publicadas no host
# POSTGRES_PASSWORD=emporio
# POSTGRES_PORT=5432
# WEB_PORT=8000
# PGADMIN_PORT=5050

# ---------- LLM padrão (todas as camadas) ----------
# Qualquer provedor compatível com a API de Chat Completions da OpenAI (docs/05-camada-llm.md).
# Presets: openai, anthropic, gemini, groq, openrouter, deepseek, ollama, lmstudio, custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Chave do provedor (OPENAI_API_KEY, GROQ_API_KEY, GEMINI_API_KEY, ...) ou LLM_API_KEY
OPENAI_API_KEY=
# LLM_BASE_URL=            (obrigatório com LLM_PROVIDER=custom)
# LLM_TEMPERATURE=         (vazio = não envia)
# LLM_REASONING_EFFORT=    (none, low, medium, high; alguns modelos só aceitam ferramentas com none)
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# LLM_STRUCTURED_OUTPUT=auto   (ou json_schema, json_object, prompt)

# ---------- Modelo por camada ----------
# Cada camada pode usar outro modelo, e até outro provedor:
#   "modelo"           mesmo provedor e chave do LLM padrão (ex.: gpt-4.1-nano)
#   "provedor:modelo"  outro preset, com a chave dele acima (ex.: groq:llama-3.3-70b-versatile)
# Vazio = LLM_MODEL. Roteador e guardrails só classificam: um modelo menor costuma bastar.
# Quando a camada troca de modelo, o reasoning dela é LLM_REASONING_EFFORT_<CAMADA>.
LLM_MODEL_AGENT=
LLM_MODEL_ROUTER=
LLM_MODEL_GUARDRAILS=
# LLM_REASONING_EFFORT_AGENT=
# LLM_REASONING_EFFORT_ROUTER=
# LLM_REASONING_EFFORT_GUARDRAILS=

# ---------- Estágios ----------
# off | shadow (avalia e registra, sem efeito) | enforce (aplica). Ver manage.py eval_router / eval_guardrails.
# ROUTER_MODE=shadow
# ROUTER_MIN_CONFIDENCE=0.5
# GUARDRAILS_MODE=shadow
# GUARDRAILS_MAX_CONSECUTIVE_BLOCKS=3
